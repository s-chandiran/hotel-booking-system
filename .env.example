# Browser values are embedded at Docker build time (Vite).
# Rebuild the image after changing these.
VITE_USE_MOCK=true
# Leave empty: the browser calls the same-origin BFF (/bff/*, /api/*), never Express directly.
VITE_API_BASE_URL=

# Runtime (container) — server-only, never sent to the browser
HOST=0.0.0.0
PORT=3000

# BFF (src/server/bff). Required when VITE_USE_MOCK=false.
# Express API origin only (no path), e.g. http://host.docker.internal:5000
API_UPSTREAM_URL=
# Exact origins allowed to make state-changing requests (comma-separated). Required in production.
# Dev default when empty: http://localhost:3000, http://127.0.0.1:3000, :8080 variants.
ALLOWED_ORIGINS=
# true = Secure + __Host- cookie (HTTPS). Defaults to true when NODE_ENV=production.
# Set false only for the plain-http localhost demo.
SESSION_COOKIE_SECURE=
# Optional property slug sent as X-Hotel-Slug on login (multi-property backend).
HOTEL_SLUG=
