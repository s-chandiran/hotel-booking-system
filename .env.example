# Copy to .env before Docker:  cp .env.example .env
# These are DEMO-ONLY values for a local client demo. Change them for any real deployment.

# Browser values are embedded at Docker build time (Vite).
# Rebuild the image after changing these.
# Leave empty: the browser calls the same-origin BFF (/bff/*, /api/*), never Express directly.
VITE_API_BASE_URL=

# Runtime (container) — server-only, never sent to the browser
HOST=0.0.0.0
PORT=3000

# BFF (src/server/bff). Required for live API access.
# Express API origin only (no path). Use http://api:5000 inside Compose.
API_UPSTREAM_URL=http://api:5000
# Exact origins allowed to make state-changing requests (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# true = Secure + __Host- cookie (HTTPS). false only for plain-http localhost demo.
SESSION_COOKIE_SECURE=false
# Property code used by the seed (defaults to demo-hotel).
HOTEL_SLUG=demo-hotel

# --- Database (docker compose `db`, `migrate`, `seed`). Never commit a filled .env. ---
# Passwords must not contain a single quote (used in the first-start init script).
MYSQL_ROOT_PASSWORD=staydesk_root_demo
DB_NAME=staydesk
# Host port bound to 127.0.0.1 only. Use 3307 if 3306 is already taken on the host.
DB_PORT=3306
# Owns DDL; used only by `docker compose run --rm migrate`.
DB_MIGRATOR_USER=staydesk_migrator
DB_MIGRATOR_PASSWORD=staydesk_migrator_demo
# Restricted runtime user: SELECT/INSERT, column-level UPDATE, no DELETE (migration 010).
DB_APP_USER=staydesk_app
DB_APP_PASSWORD=staydesk_app_demo

# --- Express API (`docker compose --profile tools up -d api`) ---
# Signs session JWTs (HS256). Required, at least 32 characters. Demo value only.
JWT_SECRET=staydesk-demo-jwt-secret-change-me-32c
# Session length in seconds (300–86400). The BFF cookie lives exactly as long as the token.
JWT_TTL_SECONDS=28800
API_PORT=5000
# Local demo: Settings → Clear demo data. Never enable on a real production host.
ALLOW_DEMO_CLEAR=true

# --- Demo seed (`docker compose --profile tools run --rm seed`) ---
# Seed also falls back to these same defaults if env vars are empty.
# Rooms created: 101–105 Normal (₹2500), 201–205 AC (₹3500).
SEED_BASE_DATE=
DEMO_FRONT_DESK_USERNAME=frontdesk
DEMO_FRONT_DESK_PASSWORD=Demo@1234
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=Demo@1234
DEMO_SUPER_ADMIN_USERNAME=superadmin
DEMO_SUPER_ADMIN_PASSWORD=Demo@1234
