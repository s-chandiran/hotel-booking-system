# Browser values are embedded at Docker build time (Vite).
# Rebuild the image after changing these.
VITE_USE_MOCK=true
# Leave empty: the browser calls the same-origin BFF (/bff/*, /api/*), never Express directly.
VITE_API_BASE_URL=

# Runtime (container) — server-only, never sent to the browser
HOST=0.0.0.0
PORT=3000

# BFF (src/server/bff). Required when VITE_USE_MOCK=false.
# Express API origin only (no path), e.g. http://host.docker.internal:5000
API_UPSTREAM_URL=
# Exact origins allowed to make state-changing requests (comma-separated). Required in production.
# Dev default when empty: http://localhost:3000, http://127.0.0.1:3000, :8080 variants.
ALLOWED_ORIGINS=
# true = Secure + __Host- cookie (HTTPS). Defaults to true when NODE_ENV=production.
# Set false only for the plain-http localhost demo.
SESSION_COOKIE_SECURE=
# Optional property slug sent as X-Hotel-Slug on login. Also the demo seed's property code
# (defaults to demo-hotel).
HOTEL_SLUG=

# --- Database (docker compose `db`, `migrate`, `seed`). Copy to .env and fill in. Never commit .env. ---
# Passwords must not contain a single quote (they are used in the first-start init script).
MYSQL_ROOT_PASSWORD=
DB_NAME=staydesk
# Host port bound to 127.0.0.1 only.
DB_PORT=3306
# Owns DDL; used only by `docker compose run --rm migrate`.
DB_MIGRATOR_USER=staydesk_migrator
DB_MIGRATOR_PASSWORD=
# Restricted runtime user: SELECT/INSERT, column-level UPDATE, no DELETE (migration 010).
DB_APP_USER=staydesk_app
DB_APP_PASSWORD=

# --- Express API (`docker compose --profile tools up -d api`, or `npm run dev:api` in backend/) ---
# Signs session JWTs (HS256). Required, at least 32 random characters, never committed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Session length in seconds (300–86400). The BFF cookie lives exactly as long as the token.
JWT_TTL_SECONDS=28800
API_PORT=5000

# --- Demo seed only (`docker compose run --rm seed`). A login is skipped if its pair is empty. ---
# Business date the demo stories are built around (YYYY-MM-DD). Empty = today in Asia/Kolkata.
SEED_BASE_DATE=
DEMO_FRONT_DESK_USERNAME=
DEMO_FRONT_DESK_PASSWORD=
DEMO_ADMIN_USERNAME=
DEMO_ADMIN_PASSWORD=
DEMO_SUPER_ADMIN_USERNAME=
DEMO_SUPER_ADMIN_PASSWORD=
