{
  "name": "staydesk-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:db": "vitest run -c vitest.integration.config.ts",
    "dev:api": "tsx watch --env-file=../.env src/api/server.ts",
    "start:api": "node dist/api/server.js",
    "db:migrate": "tsx src/db/migrate.ts latest",
    "db:status": "tsx src/db/migrate.ts status",
    "db:rollback": "tsx src/db/migrate.ts rollback",
    "db:seed:demo": "tsx src/db/seed-demo.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "mysql2": "^3.11.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vitest": "^4.1.10"
  }
}
